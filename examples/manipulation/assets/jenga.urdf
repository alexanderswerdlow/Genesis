<?xml version="1.0"?>
<robot name="jenga_block">

  <material name="birch_wood">
    <color rgba="0.89 0.76 0.58 1.0"/>  <!-- Light wood color -->
  </material>

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.013"/>  <!-- ~13 grams for standard Jenga block -->
      <inertia 
        ixx="0.00000368" 
        ixy="0" 
        ixz="0"
        iyy="0.0000254" 
        iyz="0"
        izz="0.0000271"/>
    </inertial>

    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="jenga.obj" scale="0.15 0.05 0.03"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.15 0.05 0.03"/>  <!-- Exact collision dimensions -->
      </geometry>
    </collision>
  </link>
</robot>
